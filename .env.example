# --- server -------------------------------------------------------------
PORT=3000
LOG_LEVEL=info
# http (Streamable HTTP, prod) | stdio (local dev / MCP Inspector only)
MCP_TRANSPORT=http
# openssl rand -hex 32 — the only secret. Same value goes in ~/.claude/memory.env
MCP_AUTH_TOKEN=

# --- oauth --------------------------------------------------------------
# External origin. Setting this enables OAuth, which is the ONLY way claude.ai
# web and mobile can connect — those reach the server from Anthropic's cloud and
# cannot carry a locally-configured header. Leave empty for static-bearer only.
PUBLIC_URL=
# Password for the OAuth consent screen. Defaults to MCP_AUTH_TOKEN.
OAUTH_PASSWORD=
OAUTH_ACCESS_TTL=3600
OAUTH_REFRESH_TTL=2592000

# --- opensearch ---------------------------------------------------------
OPENSEARCH_URL=http://aibrain_opensearch:9200
INDEX_PREFIX=

# --- embeddings (local ONNX, no external API) ---------------------------
EMBED_MODEL=BAAI/bge-base-en-v1.5
EMBED_DIM=768
MODEL_CACHE_DIR=/models
# fp32 keeps quality (~450 MB RAM); q8 quarters it at some recall cost
EMBED_DTYPE=fp32

# --- memory behaviour ---------------------------------------------------
DEDUPE_THRESHOLD=0.90
SUMMARY_DAYS=30
SUMMARY_MAX_EPISODES=15
RECALL_DEFAULT_K=8
DEFAULT_PROJECT=general
# cosine at/above which two memories are linked as "related" (looser than dedupe)
RELATED_THRESHOLD=0.75
RELATED_MAX=5
# memory_forget removes documents outright; set false for a recoverable soft delete
FORGET_HARD_DELETE=true
# usage metrics into the `events` index; no memory content is ever stored there
METRICS_ENABLED=true

# No ANTHROPIC_API_KEY, VOYAGE_API_KEY or OPENAI_API_KEY: the server never calls an LLM.
